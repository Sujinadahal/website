<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/nav') %>

<div class="page-hero">
  <div class="wrap">
    <div class="eyebrow">INSIGHTS</div>
    <h1>Ideas for a More Inclusive Digital Future</h1>
    <p class="lede">I write about civic technology, digital inclusion, responsible AI, public-service access, youth leadership, research and community impact.</p>
  </div>
</div>

<section>
  <div class="wrap">
    <div class="num">In Progress</div>
    <ul class="post-list">
      <% posts.slice(0, 4).forEach(function(p){ %>
        <li><%= p.title %></li>
      <% }); %>
    </ul>
    <p class="form-note" style="margin-top:24px;">More essays are on the way — check back soon, or <a href="/contact">get in touch</a> if you'd like to be notified when the first one is published.</p>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
